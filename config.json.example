{
    "global_exclude_keywords": [
        "keyword1",
        "keyword2"
    ],
    "delayed_domains": [
        "example.invalid",
        "sample-site.invalid"
    ],
    "configs": [
        {
            "category": "tech_news",
            "description": "Tech News (Posts to default Slack Channel and Mastodon)",
            "include_keywords": ["tech"],
            "exclude_keywords": ["gossip"],
            "urls": [
                "https://example.invalid/feed.xml"
            ],
            "slack_channel_id": "C012345678",
            "enable_mastodon": true
        },
        {
            "category": "private_alerts",
            "description": "Private Alerts (Custom Slack Channel, No Mastodon)",
            "include_keywords": ["alert"],
            "exclude_keywords": [],
            "urls": [
                "https://private.invalid/rss"
            ],
            "slack_channel_id": "C987654321",
            "enable_mastodon": false
        }
    ]
}