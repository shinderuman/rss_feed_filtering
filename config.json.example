{
    "global_exclude_keywords": [
        "keyword1",
        "keyword2"
    ],
    "delayed_domains": [
        "example.invalid",
        "sample-site.invalid"
    ],
    "enable_slack": true,
    "enable_mastodon": true,
    "configs": [
        {
            "include_keywords": ["tech"],
            "exclude_keywords": ["gossip"],
            "urls": [
                "https://example.invalid/feed.xml"
            ],
            "slack_channel_id": "C012345678",
            "enable_mastodon": true,
            "enable_translation": true,
            "mastodon_access_token": "optional_token_override"
        },
        {
            "include_keywords": ["alert"],
            "exclude_keywords": [],
            "urls": [
                "https://private.invalid/rss"
            ],
            "slack_channel_id": "C987654321",
            "enable_mastodon": false,
            "enable_translation": false
        }
    ]
}